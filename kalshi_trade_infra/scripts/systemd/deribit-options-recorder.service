[Unit]
Description=Deribit BTC options recorder: every option's mark and implied vol once a minute via public REST -> hourly NDJSON (archived to S3 by kalshi-tick-archiver as deribit_options + the fitted deribit_surface), the live surface in collector_state, and the trade-fitted daily history files. Runs on the COLLECTOR box.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kalshi
MemoryMax=600M
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; [ -f /opt/kalshi/.env ] && . /opt/kalshi/.env; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m data_pipeline.deribit_options record >> /opt/kalshi/logs/deribit-options-recorder.log 2>&1'
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
