[Unit]
Description=Code paper replay (app.services.code_paper): agent-written code strategies on paper probation trade each settled UTC day in the research sandbox. Paper only, no orders. Runs on the WEB box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
MemoryMax=1500M
TimeoutStartSec=1800
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.services.code_paper >> /opt/kalshi/logs/code_paper.log 2>&1'
