[Unit]
Description=Polymarket BTC binaries recorder (public keyless read-only endpoints: Gamma catalog + CLOB books every 5s) -> hourly NDJSON (archived to S3 by kalshi-tick-archiver as polymarket_markets + polymarket_top), the live snapshot in collector_state, and the 1-minute price history day files. No account, no keys, no orders. Runs on the COLLECTOR box.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kalshi
MemoryMax=400M
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; [ -f /opt/kalshi/.env ] && . /opt/kalshi/.env; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m data_pipeline.polymarket record >> /opt/kalshi/logs/polymarket-recorder.log 2>&1'
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
