[Unit]
Description=Kalshi tick recorder: every orderbook delta, trade and ticker for the BTC series -> hourly NDJSON (archived to S3 by kalshi-tick-archiver). Runs on the COLLECTOR box.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kalshi
MemoryMax=700M
# .env carries the Kalshi WS key (same as kalshi-forward-collector).
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; [ -f /opt/kalshi/.env ] && . /opt/kalshi/.env; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m data_pipeline.tick_recorder kalshi >> /opt/kalshi/logs/kalshi-tick-recorder.log 2>&1'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
