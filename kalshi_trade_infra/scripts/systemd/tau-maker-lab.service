[Unit]
Description=Market-making research lab (app.maker_lab_run): the model proposes Bitcoin quoting policies, the tick replay scores them, one finalist is judged on held-out hours; results to S3 research-watch/maker/. Paper only, no orders. Runs on the WEB box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
MemoryMax=4G
TimeoutStartSec=4h
Environment=TAU_TICK_CACHE=/opt/kalshi/ticks-cache
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.maker_lab_run --series auto >> /opt/kalshi/logs/maker_lab.log 2>&1'
