[Unit]
Description=Snapshot NBA/NHL sportsbook moneylines (The Odds API) into sports_odds. Runs on the WEB box; no-op without a key.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=10
MemoryMax=300M
TimeoutStartSec=300
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.sports_odds_collect >> /opt/kalshi/logs/sports_odds.log 2>&1'
