[Unit]
Description=Tau Kalshi catalog refresh (all markets -> series). Runs on the COLLECTOR box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
IOSchedulingClass=idle
CPUQuota=40%
MemoryMax=500M
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv/bin/python -m data_pipeline.catalog_collector'
