[Unit]
Description=Recursive agent worker (research, chat, reviews)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kalshi
# Secrets live in /opt/kalshi/.env.app (root:root, 600): GOOGLE_CLIENT_ID/SECRET,
# APP_GOOGLE_REDIRECT_URI, APP_SECRET_KEY, ANTHROPIC_API_KEY. Never in this unit.
# Optional protected market-data overlay is loaded last. Missing is compatible
# with older installations; a present unreadable/invalid file fails the start.
# Preflight is offline and logs safe metadata; only the agents unit reads this.
ExecStart=/bin/bash -ec 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; if [ -e /opt/kalshi/.env.market-data ] || [ -L /opt/kalshi/.env.market-data ]; then . /opt/kalshi/.env.market-data; /opt/kalshi/.venv/bin/python -m app.market_data_config check >> /opt/kalshi/logs/recursive_agents.log 2>&1; fi; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv/bin/python -u -m app.worker agents >> /opt/kalshi/logs/recursive_agents.log 2>&1'
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10
KillSignal=SIGTERM
TimeoutStopSec=30
# The web box is a 16GB t4g.xlarge. A research run holds a whole 1-minute market's
# snapshots (~0.5-1GB for a sports series, the worker peaks ~1.4GB) and four run at once
# (APP_AGENT_CONCURRENCY=4 in .env.app, Todd's call 2026-10-26; 4 heavy runs ~5.6GB).
# deploy_web.sh applies these caps on every deploy (systemctl set-property).
MemoryMax=8G
Nice=5

[Install]
WantedBy=multi-user.target
