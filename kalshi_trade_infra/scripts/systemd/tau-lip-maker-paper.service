[Unit]
Description=Paper liquidity-reward market maker (app.adapters.sim.maker_paper): replay each closed tick hour against real LIP pools, results to S3 ticks/v1/lip_maker_paper/. Paper only, no orders. Runs on the WEB box.
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi
Nice=15
MemoryMax=1500M
TimeoutStartSec=1200
Environment=TAU_TICK_CACHE=/opt/kalshi/ticks-cache
ExecStart=/bin/bash -c 'set -a; . /opt/kalshi/.env.aws; . /opt/kalshi/.env.app; set +a; unset AWS_PROFILE; exec /opt/kalshi/.venv313/bin/python -u -m app.adapters.sim.maker_paper hourly >> /opt/kalshi/logs/lip_maker_paper.log 2>&1'
