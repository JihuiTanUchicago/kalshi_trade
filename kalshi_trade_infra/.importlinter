; Import boundaries (ARCHITECTURE.md). CI runs `lint-imports` from kalshi_trade_infra/.
; Contracts on the NEW layers are strict. Contracts on legacy modules freeze what already holds,
; so the code can only get cleaner: when a migration removes an ignored import, delete its line.

[importlinter]
root_packages =
    trading_core
    app
    data_pipeline
include_external_packages = True

[importlinter:contract:core-is-pure]
name = trading_core imports no application code and no I/O library
type = forbidden
source_modules =
    trading_core
forbidden_modules =
    app
    data_pipeline
    requests
    pymysql
    boto3
    websockets
    cryptography

[importlinter:contract:core-layers]
name = trading_core: engine > ports > pricing > domain; each layer uses only the ones below it
type = layers
layers =
    trading_core.engine
    trading_core.ports
    trading_core.pricing
    trading_core.domain

[importlinter:contract:app-layers]
name = app: bootstrap > web > services | adapters (new subpackages, created as modules migrate)
type = layers
containers =
    app
layers =
    (bootstrap)
    (web)
    (services) | (adapters)
exhaustive = False
ignore_imports =
    ; app.repository is the legacy DB facade: it re-exports the per-aggregate modules split into
    ; app.adapters.db (step 6), and services still reach the DB through it until step 8 injects
    ; repositories. A service importing app.adapters directly is still refused.
    app.repository -> app.adapters.db.*
    ; app.backtest is the legacy research backtest: with TAU_BACKTEST_ENGINE=loop it runs DSL specs
    ; through the Kalshi TradingLoop adapter (step 8c). Services reach it via gatekeeper/partitions.
    ; Delete when the backtest itself moves under app.services with the adapter injected.
    app.backtest -> app.adapters.kalshi.spec_strategy
    ; app.engine is the legacy paper/live engine: with TAU_ENGINE_LOOP=paper it runs a decision as a
    ; TradingLoop step over the Kalshi and DB adapters (step 8, paper). Delete when the engine's
    ; decision moves under app.services with its adapters injected by the bootstrap.
    app.engine -> app.adapters.**
    ; The legacy backtest (forecast_book) and engine (run_forever, the live composition root until
    ; app.bootstrap exists) wire the Polymarket fair-value book in themselves; services reach them via
    ; gatekeeper/agent. Delete when step 5 injects FeatureProviders from app.bootstrap.
    app.backtest -> app.adapters.polymarket.features
    app.engine -> app.adapters.polymarket.features
    app.engine -> app.adapters.polymarket.store
    ; The external data clients (sports odds, weather forecasts, options, free data, tick datasets,
    ; market-data helpers) moved into app.adapters.data on 2026-10-26. The flat legacy modules already
    ; imported them, so this records existing dependencies, not new ones. `*` is one segment: it
    ; covers app.<legacy module> only, never app.services.* or app.web.*. Narrow it as those modules
    ; move under app.services with the providers injected (step 5).
    app.* -> app.adapters.data.*
    ; services.markets catches the perps config error type (MarketDataError) next to its legacy perps
    ; imports; goes when perps moves behind the Venue port (step 11).
    app.services.markets -> app.adapters.data.market_data_common
; Add when app.web exists: a forbidden contract app.web -> app.adapters (web reaches adapters only
; through services and the bootstrap wiring).

[importlinter:contract:collector-tier-independent]
name = data_pipeline (the collector box ships only this package) never imports app
type = forbidden
source_modules =
    data_pipeline
forbidden_modules =
    app
ignore_imports =
    ; runs on the web box, not the collector (scripts/systemd). Move to app.adapters when migrated.
    data_pipeline.taostats_collector -> app.markets
    data_pipeline.taostats_collector -> app.tao_repository

[importlinter:contract:server-is-top]
name = nothing imports the web server module
type = forbidden
source_modules =
    app.engine
    app.backtest
    app.spec
    app.markets
    app.gatekeeper
    app.agent
    app.repository
    app.worker
    data_pipeline
forbidden_modules =
    app.server

[importlinter:contract:live-path-no-research]
name = the live engine never imports the research agent, LLM client or web server
type = forbidden
source_modules =
    app.engine
    app.execution
    data_pipeline.architecture
forbidden_modules =
    app.agent
    app.llm
    app.server
    app.dreaming

[importlinter:contract:pure-math-stays-pure]
name = quant/stats/fees/order contracts do no I/O
type = forbidden
source_modules =
    app.quant
    app.stats
    data_pipeline.kalshi_fees
    data_pipeline.architecture.contracts
forbidden_modules =
    app.repository
    data_pipeline.common
    requests
    pymysql
    boto3
