# Production market-data profile. Copy to a private operator file, chmod 0600,
# then fill in values there. NEVER put real keys in this tracked template.
# scripts/configure_market_data.py validates only unless --apply is supplied.
# File entries, including blanks, override recognized process environment values.
# The installed overlay includes all effective defaults, so old .env.app settings
# cannot silently reactivate an omitted provider or change a feed after validation.
# Literal single-line KEY=VALUE / export KEY=VALUE only; no shell expansion.

# Primary historical equity/ETF bars, not a Databento live stream.
TAU_MARKET_DATA_PRIMARY=databento
TAU_DATABENTO_ENABLED=1
DATABENTO_API_KEY=
# Select datasets licensed for your account; EQUS.MINI is an example, not SIP.
TAU_DATABENTO_DATASETS=EQUS.MINI
TAU_DATABENTO_DEFAULT_DATASET=EQUS.MINI
# REQUIRED: operator-selected positive estimated-download budget per agent-data
# context. Zero intentionally fails preflight. This is NOT a monthly/global cap.
TAU_DATABENTO_MAX_COST_USD=0

# Current equity/ETF snapshots still use Alpaca. Its brokerage OAuth is separate.
TAU_ALPACA_ENABLED=1
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# IEX is one exchange. Change to sip only with consolidated-feed entitlement.
TAU_ALPACA_FEED=iex
TAU_ALPACA_SYMBOLS=SPY,QQQ,IWM,TLT,GLD,USO
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets

# Spot FX, published daily rates and options-chain/Greeks context still use Massive.
# Disable the provider or remove datasets your subscription does not include.
TAU_MASSIVE_ENABLED=1
MASSIVE_API_KEY=
TAU_MASSIVE_FX_FEED=end_of_day
TAU_MASSIVE_FX_SYMBOLS=EURUSD,USDJPY,GBPUSD
TAU_MASSIVE_DATASETS=fx,treasury_yields,funding_conditions,options
