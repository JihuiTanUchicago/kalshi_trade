# Tau — example environment. Copy to .env and fill in. NEVER commit real values.
# Only the names are listed here; nothing in this file is a secret.

# --- Database (MySQL) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- App server / auth ---
APP_HOST=0.0.0.0
APP_PORT=8090
APP_SECRET_KEY=            # random 32+ bytes; session/crypto key
APP_DEV_LOGIN=             # "1" to allow dev login (keep OFF in prod)
APP_INSECURE_COOKIES=      # "1" only for local http
GOOGLE_CLIENT_ID=          # Google OAuth
GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REDIRECT_URI=https://your-app.example.com/auth/callback

# --- LLM / research agent (Bedrock or Anthropic direct) ---
APP_LLM_PROVIDER=bedrock   # "bedrock" | "anthropic"
APP_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
APP_AGENT_MAX_TOKENS=6000
APP_AGENT_CONCURRENCY=
ANTHROPIC_API_KEY=         # only if APP_LLM_PROVIDER=anthropic
AWS_REGION=us-east-1

# --- Kalshi (market data + live orders) ---
KALSHI_BASE_URL=
KALSHI_WS_KEY_ID=          # Kalshi API key id
KALSHI_WS_PRIVATE_KEY_PATH=  # path to the RSA private key file (never commit the key)
KALSHI_DEV_API_BASE=       # optional: Kalshi dev env for the 2nd backtest curve

# --- Execution tuning (MarketableLimitKernel; see EXECUTION_DESIGN.md) ---
# All optional. Blank/unset = OFF (prior behaviour). Each can only shrink or
# abandon an order and none can block an exit, so setting any is strictly safer.
KALSHI_MAX_BOOK_FRACTION=  # cap each child order to this fraction of the resting touch (e.g. 0.25)
KALSHI_MAX_ENTRY_SPREAD=   # abandon a non-urgent ENTRY when the touch spread exceeds this (e.g. 0.05)
KALSHI_MAX_ORDER_NOTIONAL= # hard per-order $ backstop on BUYS only (defence-in-depth; e.g. 50)

# --- Live trading gate (DANGER: real orders) ---
APP_LIVE_TRADING_ENABLED=  # unset/false by default; real orders fire only when true
LIVE_TRADING_PASSWORD=     # extra gate for enabling live mode
RISK_ENGINE_MODE=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Operator / dashboard (internal monitoring surface) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=        # set a strong value; no hardcoded default
DASHBOARD_URL=https://your-dashboard.example.com
ADMIN_EMAIL=               # which account is the operator/admin
FROM_EMAIL=

# --- Data lake / collectors (optional, for the hosted pipeline) ---
DATALAKE_BUCKET=
SNAPSHOT_RPS=5
SNAPSHOT_WORKERS=6

# --- Alpaca stock/ETF data for the research agent and copilot (read-only) ---
# Set these in the SERVER/AGENT environment, never the browser or a chat message.
TAU_ALPACA_ENABLED=0       # set to 1 to include data in actual agent runs
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
TAU_ALPACA_FEED=iex        # iex = single exchange; sip = consolidated (requires entitlement)
TAU_ALPACA_SYMBOLS=SPY,QQQ,IWM,TLT,GLD,USO
# Fixed read-only data host. Do not use paper-api.alpaca.markets here.
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets

# --- Massive FX, rates and option-chain context (read-only REST) ---
# Real keys belong only in an ignored .env or the server secret store.
# The worker must explicitly load that env file; copying it to disk is not enough.
TAU_MASSIVE_ENABLED=0
MASSIVE_API_KEY=
# end_of_day accommodates Currencies Basic; realtime requires matching entitlement.
TAU_MASSIVE_FX_FEED=end_of_day
TAU_MASSIVE_FX_SYMBOLS=EURUSD,USDJPY,GBPUSD
# Remove datasets your subscription does not include. Option chains are on demand.
TAU_MASSIVE_DATASETS=fx,treasury_yields,funding_conditions,options

# --- Databento historical OHLCV context (read-only, on demand) ---
# Keep the real key in this product's ignored .env or the server secret store.
DATABENTO_API_KEY=
TAU_DATABENTO_ENABLED=0
# Explicit allowlist of licensed dataset codes; e.g. EQUS.MINI,GLBX.MDP3.
# No dataset is selected automatically and providers never silently fall back.
TAU_DATABENTO_DATASETS=
# Estimated-download budget per agent-data context (shared across its requests).
# Zero rejects positive-cost downloads. This is not an account-wide billing cap.
TAU_DATABENTO_MAX_COST_USD=0

# --- Exa web/news/publication research (on demand; disabled until configured) ---
# Real keys belong only in the ignored .env or server secret store. Never in examples.
# The worker must explicitly load its env file. No Exa quota-table migration is needed.
EXA_API_KEY=
TAU_EXA_ENABLED=0
TAU_EXA_HISTORICAL_ENABLED=0
# Historical research additionally needs Exa Snapshot entitlement. No current-web fallback.
# No app spending, request, batch or tool-round quotas. Provider account limits still apply.
# Provider costs are telemetry in run events; no automatic paid retries.
