# Alpaca Market Data API base URL. Historical data uses this endpoint with paper keys.
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets

# Fill these values in the private .env file, not this example or chat.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Grok research calls use the same private .env. Public model/endpoint/pricing
# settings are configurable in config/grok.local.json.
XAI_API_KEY=
